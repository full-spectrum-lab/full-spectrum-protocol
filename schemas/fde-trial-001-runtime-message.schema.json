{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullspectrumprotocol.com/schemas/fde-trial-001-runtime-message.schema.json",
  "title": "FDE-TRIAL-001 local offline runtime message",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "fixture_version", "message_type", "payload"],
  "properties": {
    "schema_version": {"const": "fde-trial-001-runtime/0.1.0-rc"},
    "case_id": {"const": "FDE-TRIAL-001"},
    "fixture_version": {"const": "0.1.0-rc"},
    "message_type": {"enum": ["ENGINE_PRE_ACTION_AUDIT", "HUMAN_DECISION", "ACTION_OUTCOME", "ACTION_RECONCILIATION_QUERY", "ACTION_RECONCILIATION_RESULT"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"message_type": {"const": "ENGINE_PRE_ACTION_AUDIT"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/enginePreActionAudit"}}}},
    {"if": {"properties": {"message_type": {"const": "HUMAN_DECISION"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/humanDecision"}}}},
    {"if": {"properties": {"message_type": {"const": "ACTION_OUTCOME"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/actionOutcome"}}}},
    {"if": {"properties": {"message_type": {"const": "ACTION_RECONCILIATION_QUERY"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/reconciliationQuery"}}}},
    {"if": {"properties": {"message_type": {"const": "ACTION_RECONCILIATION_RESULT"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/reconciliationResult"}}}}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "enginePreActionAudit": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "request_id", "correlation_id", "knowledge_snapshot_ref", "engine_input", "engine_input_sha256", "engine_result", "engine_result_sha256", "original_engine_result_sha256", "occurred_at"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"}, "request_id": {"$ref": "#/$defs/id"}, "correlation_id": {"$ref": "#/$defs/id"}, "knowledge_snapshot_ref": {"$ref": "#/$defs/id"},
        "engine_input": {"type": "object"}, "engine_input_sha256": {"$ref": "#/$defs/sha256"},
        "engine_result": {"$ref": "#/$defs/engineResult"}, "engine_result_sha256": {"$ref": "#/$defs/sha256"}, "original_engine_result_sha256": {"$ref": "#/$defs/sha256"}, "occurred_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "engineResult": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "generation", "decision", "verification_status", "hard_gate", "real_action_allowed", "result_digest", "original_engine_result_digest"],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"}, "generation": {"const": "GEN2"}, "decision": {"const": "REVIEW_REQUIRED"}, "verification_status": {"const": "FIXTURE_EXPECTATION_ONLY"}, "hard_gate": {"const": "FAIL"}, "real_action_allowed": {"const": false}, "result_digest": {"$ref": "#/$defs/sha256"}, "original_engine_result_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "humanDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "engine_audit_event_id", "correlation_id", "knowledge_snapshot_ref", "policy_id", "policy_version", "decision", "resulting_snapshot_state", "actor_id", "authority_ref", "authority_scope", "authority_issued_at", "authority_expires_at", "occurred_at"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"}, "engine_audit_event_id": {"$ref": "#/$defs/id"}, "correlation_id": {"$ref": "#/$defs/id"}, "knowledge_snapshot_ref": {"$ref": "#/$defs/id"}, "policy_id": {"const": "refund-policy"}, "policy_version": {"const": "2.0-proposed"},
        "decision": {"enum": ["APPROVE", "REJECT"]}, "resulting_snapshot_state": {"enum": ["ACTIVE", "REJECTED"]}, "actor_id": {"$ref": "#/$defs/id"}, "authority_ref": {"$ref": "#/$defs/id"}, "authority_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["APPROVE_POLICY_ACTIVATION", "REJECT_POLICY_ACTIVATION", "AUTHORIZE_LOCAL_FAKE_ACTION"]}}, "authority_issued_at": {"$ref": "#/$defs/timestamp"}, "authority_expires_at": {"$ref": "#/$defs/timestamp"}, "occurred_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "actionOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "human_decision_event_id", "correlation_id", "outcome", "action_type", "target_ref", "action_idempotency_key", "input_sha256", "result_sha256", "receipt", "occurred_at"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"}, "human_decision_event_id": {"$ref": "#/$defs/id"}, "correlation_id": {"$ref": "#/$defs/id"}, "outcome": {"enum": ["ACTION_RECEIPT", "NO_ACTION"]}, "action_type": {"const": "SIMULATE_REFUND_POLICY_CHANGE"}, "target_ref": {"$ref": "#/$defs/id"}, "action_idempotency_key": {"$ref": "#/$defs/id"}, "input_sha256": {"$ref": "#/$defs/sha256"}, "result_sha256": {"$ref": "#/$defs/sha256"}, "receipt": {"type": ["object", "null"]}, "occurred_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "reconciliationQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["query_id", "correlation_id", "action_idempotency_key", "requested_at"],
      "properties": {"query_id": {"$ref": "#/$defs/id"}, "correlation_id": {"$ref": "#/$defs/id"}, "action_idempotency_key": {"$ref": "#/$defs/id"}, "requested_at": {"$ref": "#/$defs/timestamp"}}
    },
    "reconciliationResult": {
      "type": "object", "additionalProperties": false,
      "required": ["query_id", "correlation_id", "action_idempotency_key", "status", "receipt", "retry_allowed", "resolved_at"],
      "properties": {"query_id": {"$ref": "#/$defs/id"}, "correlation_id": {"$ref": "#/$defs/id"}, "action_idempotency_key": {"$ref": "#/$defs/id"}, "status": {"enum": ["FOUND", "NOT_FOUND", "UNKNOWN"]}, "receipt": {"type": ["object", "null"]}, "retry_allowed": {"const": false}, "resolved_at": {"$ref": "#/$defs/timestamp"}}
    }
  }
}
