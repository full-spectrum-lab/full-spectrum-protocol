{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullspectrumprotocol.com/schemas/fde-trial-001-fixture.schema.json",
  "title": "FDE-TRIAL-001 frozen input document",
  "type": "object",
  "required": ["schema_version", "case_id", "document_type", "payload"],
  "properties": {
    "schema_version": {"const": "0.1.0-rc"},
    "case_id": {"const": "FDE-TRIAL-001"},
    "document_type": {"enum": ["POLICY_BEFORE", "POLICY_PROPOSED", "ORDER_FACTS", "ACTOR_AND_AUTHORITY", "SNAPSHOT_BINDING", "EXPECTED_DECISION"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"document_type": {"const": "POLICY_BEFORE"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/policyBefore"}}}},
    {"if": {"properties": {"document_type": {"const": "POLICY_PROPOSED"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/policyProposed"}}}},
    {"if": {"properties": {"document_type": {"const": "ORDER_FACTS"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/orderFacts"}}}},
    {"if": {"properties": {"document_type": {"const": "ACTOR_AND_AUTHORITY"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/actorAuthority"}}}},
    {"if": {"properties": {"document_type": {"const": "SNAPSHOT_BINDING"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/snapshotBinding"}}}},
    {"if": {"properties": {"document_type": {"const": "EXPECTED_DECISION"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/expectedDecision"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "policyBefore": {"type": "object", "required": ["policy_id", "version", "status", "rule", "source_ref", "effective_from"], "properties": {"policy_id": {"const": "refund-policy"}, "version": {"const": "1.0"}, "status": {"const": "ACTIVE"}, "rule": {"type": "string"}, "source_ref": {"type": "string"}, "effective_from": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
    "policyProposed": {"type": "object", "required": ["policy_id", "version", "parent_version", "status", "rule", "risk_scope", "proposed_by"], "properties": {"policy_id": {"const": "refund-policy"}, "version": {"const": "2.0-proposed"}, "parent_version": {"const": "1.0"}, "status": {"const": "PROPOSED"}, "rule": {"type": "string"}, "risk_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "proposed_by": {"type": "string"}}, "additionalProperties": false},
    "orderFacts": {"type": "object", "required": ["synthetic", "order_ref", "item_value_band", "risk_level", "package_opened", "refund_requested"], "properties": {"synthetic": {"const": true}, "order_ref": {"type": "string"}, "item_value_band": {"const": "HIGH"}, "risk_level": {"const": "HIGH"}, "package_opened": {"const": true}, "refund_requested": {"const": true}}, "additionalProperties": false},
    "actorAuthority": {"type": "object", "required": ["observer", "engine", "knowledge_governance", "human_approver", "action_sink"], "properties": {"observer": {"const": "OBSERVE_AND_PROJECT_ONLY"}, "engine": {"const": "ADVISE_ONLY"}, "knowledge_governance": {"const": "PERSIST_AUDIT_REPLAY"}, "human_approver": {"const": "APPROVE_OR_REJECT"}, "action_sink": {"const": "LOCAL_FAKE_ONLY"}}, "additionalProperties": false},
    "snapshotBinding": {"type": "object", "required": ["engine_commit", "observer_commit", "kg_commit", "protocol_schema_version", "knowledge_snapshot_ref"], "properties": {"engine_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "observer_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "kg_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "protocol_schema_version": {"const": "fde-trial-001/0.1.0-rc"}, "knowledge_snapshot_ref": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "expectedDecision": {"type": "object", "required": ["decision", "verification_status", "hard_gate", "real_action_allowed"], "properties": {"decision": {"const": "REVIEW_REQUIRED"}, "verification_status": {"const": "FIXTURE_EXPECTATION_ONLY"}, "hard_gate": {"const": "FAIL"}, "real_action_allowed": {"const": false}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
